meta {
  name: Error 409 · pedido no servido
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/orders/:order_id/invoice
  body: none
  auth: bearer
}

params:path {
  order_id: {{pendingOrderId}}
}

auth:bearer {
  token: {{tokenWaiter}}
}

tests {
  test("status 409", function() {
    expect(res.status).to.equal(409);
  });

  test("error {detail, code} con code order_not_served", function() {
    expect(res.body.detail).to.be.a("string");
    expect(res.body.code).to.equal("order_not_served");
  });
}

docs {
  **`POST /orders/{order_id}/invoice`**

  Solo se facturan pedidos `served`.

  **Roles permitidos:** admin, waiter

  **Auth en este request:** Bearer `{{tokenWaiter}}` (waiter)

  **Respuestas posibles:**

  - `409`: `order_not_served`
}
