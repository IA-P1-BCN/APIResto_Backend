meta {
  name: Error 404 · factura inexistente
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/invoices/:invoice_id
  body: none
  auth: bearer
}

params:path {
  invoice_id: 999999999
}

auth:bearer {
  token: {{token}}
}

tests {
  test("status 404", function() {
    expect(res.status).to.equal(404);
  });

  test("error {detail, code} con code not_found", function() {
    expect(res.body.detail).to.be.a("string");
    expect(res.body.code).to.equal("not_found");
  });
}

docs {
  **`GET /invoices/{invoice_id}`**

  Id de factura que no existe.

  **Roles permitidos:** admin, waiter

  **Auth en este request:** Bearer `{{token}}` (admin)

  **Respuestas posibles:**

  - `404`: `Invoice not found`
}
