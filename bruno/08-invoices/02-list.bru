meta {
  name: Listar facturas
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/invoices?page=1&size=20
  body: none
  auth: bearer
}

params:query {
  page: 1
  size: 20
}

auth:bearer {
  token: {{tokenWaiter}}
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });

  test("shape Page: items, total, page, size", function() {
    expect(res.body.items).to.be.an("array");
    expect(res.body.total).to.be.a("number");
    expect(res.body.page).to.be.a("number");
    expect(res.body.size).to.be.a("number");
  });

  test("incluye la factura recién creada (si cabe en la página 1)", function() {
    expect(res.body.total).to.be.at.least(1);
    if (res.body.total <= res.body.size) {
      expect(res.body.items.map(i => i.id)).to.include(bru.getVar("invoiceId"));
    }
  });
}

docs {
  **`GET /invoices`**

  Listado paginado por número de factura. Filtros `date_from`, `date_to` (fecha de emisión, ambos incluidos).

  **Roles permitidos:** admin, waiter

  **Auth en este request:** Bearer `{{tokenWaiter}}` (waiter)

  **Respuestas posibles:**

  - `200`: `Page[InvoiceOut]`
  - `401`: sin token (`unauthorized`)
  - `403`: rol no permitido (`forbidden`)
  - `422`: `invalid_date_range` si `date_from > date_to`; `validation_error` si `page < 1` o `size` fuera de 1..100
}
