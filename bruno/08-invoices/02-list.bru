meta {
  name: Listar facturas
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/invoices?page=1&size=20
  body: none
  auth: bearer
}

params:query {
  page: 1
  size: 20
}

auth:bearer {
  token: {{tokenWaiter}}
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });

  test("shape Page: items, total, page, size", function() {
    expect(res.body.items).to.be.an("array");
    expect(res.body.total).to.be.a("number");
    expect(res.body.page).to.be.a("number");
    expect(res.body.size).to.be.a("number");
  });
}

docs {
  **`GET /invoices`**

  Listado paginado por número de factura. Filtros `date_from`, `date_to` (fecha de emisión, ambos incluidos).

  **Roles permitidos:** admin, waiter

  **Auth en este request:** Bearer `{{tokenWaiter}}` (waiter)

  **Respuestas posibles:**

  - `200`: `Page[InvoiceOut]`
  - `401`: sin token
  - `403`: rol no permitido
  - `404`: `Order not found` / `Invoice not found`
  - `409`: `order_not_served` o `invoice_already_exists`
  - `422`: `invalid_date_range`
}
