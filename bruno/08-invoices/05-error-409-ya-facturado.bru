meta {
  name: Error 409 · pedido ya facturado
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/orders/:order_id/invoice
  body: none
  auth: bearer
}

params:path {
  order_id: {{orderId}}
}

auth:bearer {
  token: {{tokenWaiter}}
}

tests {
  test("status 409", function() {
    expect(res.status).to.equal(409);
  });

  test("error {detail, code} con code invoice_already_exists", function() {
    expect(res.body.detail).to.be.a("string");
    expect(res.body.code).to.equal("invoice_already_exists");
  });
}

docs {
  **`POST /orders/{order_id}/invoice`**

  Un pedido solo tiene una factura.

  **Roles permitidos:** admin, waiter

  **Auth en este request:** Bearer `{{tokenWaiter}}` (waiter)

  **Respuestas posibles:**

  - `409`: `invoice_already_exists`
}
