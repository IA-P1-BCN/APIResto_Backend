meta {
  name: Error 404 · facturar pedido inexistente
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/orders/:order_id/invoice
  body: none
  auth: bearer
}

params:path {
  order_id: 999999999
}

auth:bearer {
  token: {{token}}
}

tests {
  test("status 404", function() {
    expect(res.status).to.equal(404);
  });

  test("error {detail, code} con code not_found", function() {
    expect(res.body.detail).to.be.a("string");
    expect(res.body.code).to.equal("not_found");
  });
}

docs {
  **`POST /orders/{order_id}/invoice`**

  Id de pedido que no existe.

  **Roles permitidos:** admin, waiter

  **Auth en este request:** Bearer `{{token}}` (admin)

  **Respuestas posibles:**

  - `404`: `Order not found`
}
