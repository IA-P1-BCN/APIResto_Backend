meta {
  name: Error 422 · login sin password
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/auth/login
  body: formUrlEncoded
  auth: none
}

headers {
  Content-Type: application/x-www-form-urlencoded
}

body:form-urlencoded {
  username: {{adminEmail}}
}

tests {
  test("status 422", function() {
    expect(res.status).to.equal(422);
  });

  test("error {detail, code} con code validation_error", function() {
    expect(res.body.detail).to.be.a("string");
    expect(res.body.code).to.equal("validation_error");
  });
  test("incluye la lista de errores de campo", function() {
    expect(res.body.errors).to.be.an("array").that.is.not.empty;
  });
}

docs {
  **`POST /auth/login`**

  El formulario de login exige `username` y `password`.

  **Roles permitidos:** público

  **Auth en este request:** ninguna

  **Respuestas posibles:**

  - `200`: `{access_token, token_type: "bearer"}`
  - `401`: credenciales incorrectas o usuario desactivado (`unauthorized`)
  - `422`: faltan `username` o `password` (`validation_error`)
}
