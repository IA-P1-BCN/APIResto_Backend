meta {
  name: Error 404 · desactivar usuario inexistente
  type: http
  seq: 9
}

patch {
  url: {{baseUrl}}/users/:user_id/deactivate
  body: none
  auth: bearer
}

params:path {
  user_id: 999999999
}

auth:bearer {
  token: {{token}}
}

tests {
  test("status 404", function() {
    expect(res.status).to.equal(404);
  });

  test("error {detail, code} con code not_found", function() {
    expect(res.body.detail).to.be.a("string");
    expect(res.body.code).to.equal("not_found");
  });
}

docs {
  **`PATCH /users/{user_id}/deactivate`**

  Id que no existe.

  **Roles permitidos:** admin

  **Auth en este request:** Bearer `{{token}}` (admin)

  **Respuestas posibles:**

  - `404`: `not_found` (`User not found`)
}
