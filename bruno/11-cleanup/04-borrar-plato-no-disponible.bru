meta {
  name: Borrar plato no disponible
  type: http
  seq: 4
}

delete {
  url: {{baseUrl}}/dishes/:dish_id
  body: none
  auth: bearer
}

params:path {
  dish_id: {{unavailableDishId}}
}

auth:bearer {
  token: {{token}}
}

tests {
  test("status 204", function() {
    expect(res.status).to.equal(204);
  });
}

docs {
  **`DELETE /dishes/{dish_id}`**

  El plato no disponible no llegó a usarse en pedidos, así que se puede borrar.

  **Roles permitidos:** admin

  **Auth en este request:** Bearer `{{token}}` (admin)

  **Respuestas posibles:**

  - `204`: sin contenido
  - `401`: sin token
  - `403`: escritura con un rol distinto de admin
  - `404`: `Dish not found`
  - `409`: plato usado en pedidos (al borrar)
  - `422`: datos no válidos
}
