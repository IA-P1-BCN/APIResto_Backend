meta {
  name: Error 409 · borrar categoría con platos
  type: http
  seq: 3
}

delete {
  url: {{baseUrl}}/categories/:category_id
  body: none
  auth: bearer
}

params:path {
  category_id: {{categoryId}}
}

auth:bearer {
  token: {{token}}
}

tests {
  test("status 409", function() {
    expect(res.status).to.equal(409);
  });

  test("error {detail, code} con code conflict", function() {
    expect(res.body.detail).to.be.a("string");
    expect(res.body.code).to.equal("conflict");
  });
}

docs {
  **`DELETE /categories/{category_id}`**

  Una categoría con platos no se borra.

  **Roles permitidos:** admin

  **Auth en este request:** Bearer `{{token}}` (admin)

  **Respuestas posibles:**

  - `409`: `conflict` (`Category has dishes and cannot be deleted`)
}
