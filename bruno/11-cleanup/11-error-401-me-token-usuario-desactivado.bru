meta {
  name: Error 401 · token de un usuario desactivado
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/auth/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenCustomer}}
}

tests {
  test("status 401", function() {
    expect(res.status).to.equal(401);
  });

  test("error {detail, code} con code unauthorized", function() {
    expect(res.body.detail).to.be.a("string");
    expect(res.body.code).to.equal("unauthorized");
  });

  test("detail = Invalid or expired token", function() {
    expect(res.body.detail).to.equal("Invalid or expired token");
  });
}

docs {
  **`GET /auth/me`**

  El token emitido antes de la desactivación deja de ser válido: equivale a cerrar la sesión.

  **Roles permitidos:** cualquier usuario activo

  **Auth en este request:** Bearer `{{tokenCustomer}}` (customer)

  **Respuestas posibles:**

  - `401`: `unauthorized` (`Invalid or expired token`)
}
