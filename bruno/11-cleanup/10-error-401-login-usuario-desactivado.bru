meta {
  name: Error 401 · login de un usuario desactivado
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/auth/login
  body: formUrlEncoded
  auth: none
}

headers {
  Content-Type: application/x-www-form-urlencoded
}

body:form-urlencoded {
  username: {{customerEmail}}
  password: {{testPassword}}
}

tests {
  test("status 401", function() {
    expect(res.status).to.equal(401);
  });

  test("error {detail, code} con code unauthorized", function() {
    expect(res.body.detail).to.be.a("string");
    expect(res.body.code).to.equal("unauthorized");
  });

  test("detail = Credenciales incorrectas", function() {
    expect(res.body.detail).to.equal("Credenciales incorrectas");
  });
}

docs {
  **`POST /auth/login`**

  Un usuario desactivado no puede iniciar sesión.

  **Roles permitidos:** público

  **Auth en este request:** ninguna

  **Respuestas posibles:**

  - `200`: `{access_token, token_type: "bearer"}`
  - `401`: credenciales incorrectas o usuario desactivado (`unauthorized`, `Credenciales incorrectas`)
  - `422`: faltan `username` o `password` (`validation_error`)
}
