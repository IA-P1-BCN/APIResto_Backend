meta {
  name: Error 409 · borrar plato usado en pedidos
  type: http
  seq: 1
}

delete {
  url: {{baseUrl}}/dishes/:dish_id
  body: none
  auth: bearer
}

params:path {
  dish_id: {{dishId}}
}

auth:bearer {
  token: {{token}}
}

tests {
  test("status 409", function() {
    expect(res.status).to.equal(409);
  });

  test("error {detail, code} con code conflict", function() {
    expect(res.body.detail).to.be.a("string");
    expect(res.body.code).to.equal("conflict");
  });
}

docs {
  **`DELETE /dishes/{dish_id}`**

  Un plato con pedidos no se borra: hay que marcarlo `is_available=false`.

  **Roles permitidos:** admin

  **Auth en este request:** Bearer `{{token}}` (admin)

  **Respuestas posibles:**

  - `409`: `conflict` (`Dish is used in orders and cannot be deleted. Mark it as unavailable instead`)
}
