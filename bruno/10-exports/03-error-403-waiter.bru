meta {
  name: Error 403 · exportar como waiter
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/exports/invoices
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenWaiter}}
}

tests {
  test("status 403", function() {
    expect(res.status).to.equal(403);
  });

  test("error {detail, code} con code forbidden", function() {
    expect(res.body.detail).to.be.a("string");
    expect(res.body.code).to.equal("forbidden");
  });
}

docs {
  **`GET /exports/invoices`**

  Solo admin.

  **Roles permitidos:** admin

  **Auth en este request:** Bearer `{{tokenWaiter}}` (waiter)

  **Respuestas posibles:**

  - `403`: `forbidden` (`Not enough permissions`)
}
