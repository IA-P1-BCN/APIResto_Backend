meta {
  name: Error 422 · rango de fechas inválido
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/exports/orders?date_from=2026-12-31&date_to=2026-01-01
  body: none
  auth: bearer
}

params:query {
  date_from: 2026-12-31
  date_to: 2026-01-01
}

auth:bearer {
  token: {{token}}
}

tests {
  test("status 422", function() {
    expect(res.status).to.equal(422);
  });

  test("error {detail, code} con code invalid_date_range", function() {
    expect(res.body.detail).to.be.a("string");
    expect(res.body.code).to.equal("invalid_date_range");
  });
}

docs {
  **`GET /exports/orders`**

  `date_from` debe ser anterior o igual a `date_to`.

  **Roles permitidos:** admin

  **Auth en este request:** Bearer `{{token}}` (admin)

  **Respuestas posibles:**

  - `422`: `invalid_date_range`
}
