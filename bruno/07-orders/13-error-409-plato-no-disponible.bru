meta {
  name: Error 409 · plato no disponible
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/orders/
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{tokenWaiter}}
}

body:json {
  {
    "table_id": {{tableId}},
    "items": [
      {
        "dish_id": {{unavailableDishId}},
        "quantity": 1
      }
    ]
  }
}

tests {
  test("status 409", function() {
    expect(res.status).to.equal(409);
  });

  test("error {detail, code} con code conflict", function() {
    expect(res.body.detail).to.be.a("string");
    expect(res.body.code).to.equal("conflict");
  });
}

docs {
  **`POST /orders/`**

  No se pueden pedir platos con `is_available=false` (ni platos inexistentes).

  **Roles permitidos:** admin, waiter

  **Auth en este request:** Bearer `{{tokenWaiter}}` (waiter)

  **Respuestas posibles:**

  - `409`: `Dish <id> not available`
}
