meta {
  name: Error 404 · línea de pedido inexistente
  type: http
  seq: 16
}

patch {
  url: {{baseUrl}}/orders/:order_id/items/:item_id
  body: json
  auth: bearer
}

params:path {
  order_id: {{orderId}}
  item_id: 999999999
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "prepared": true
  }
}

tests {
  test("status 404", function() {
    expect(res.status).to.equal(404);
  });

  test("error {detail, code} con code not_found", function() {
    expect(res.body.detail).to.be.a("string");
    expect(res.body.code).to.equal("not_found");
  });
}

docs {
  **`PATCH /orders/{order_id}/items/{item_id}`**

  La línea debe pertenecer al pedido.

  **Roles permitidos:** admin, waiter, kitchen, bartender

  **Auth en este request:** Bearer `{{token}}` (admin)

  **Respuestas posibles:**

  - `404`: `Order item not found`
}
