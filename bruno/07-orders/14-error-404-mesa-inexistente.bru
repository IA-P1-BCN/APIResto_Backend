meta {
  name: Error 404 · pedido para una mesa inexistente
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/orders/
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{tokenWaiter}}
}

body:json {
  {
    "table_id": 999999999,
    "items": [
      {
        "dish_id": {{dishId}},
        "quantity": 1
      }
    ]
  }
}

tests {
  test("status 404", function() {
    expect(res.status).to.equal(404);
  });

  test("error {detail, code} con code not_found", function() {
    expect(res.body.detail).to.be.a("string");
    expect(res.body.code).to.equal("not_found");
  });
}

docs {
  **`POST /orders/`**

  La mesa debe existir.

  **Roles permitidos:** admin, waiter

  **Auth en este request:** Bearer `{{tokenWaiter}}` (waiter)

  **Respuestas posibles:**

  - `404`: `Table not found`
}
