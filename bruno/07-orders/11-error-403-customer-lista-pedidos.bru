meta {
  name: Error 403 · customer lista pedidos
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/orders/
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenCustomer}}
}

tests {
  test("status 403", function() {
    expect(res.status).to.equal(403);
  });

  test("error {detail, code} con code forbidden", function() {
    expect(res.body.detail).to.be.a("string");
    expect(res.body.code).to.equal("forbidden");
  });
}

docs {
  **`GET /orders/`**

  customer no tiene acceso a pedidos.

  **Roles permitidos:** admin, waiter, kitchen, bartender

  **Auth en este request:** Bearer `{{tokenCustomer}}` (customer)

  **Respuestas posibles:**

  - `403`: `Not enough permissions`
}
