meta {
  name: Estado → in_kitchen (kitchen)
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/orders/:order_id/status
  body: json
  auth: bearer
}

params:path {
  order_id: {{orderId}}
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{tokenKitchen}}
}

body:json {
  {
    "status": "in_kitchen"
  }
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });

  test("in_kitchen", function() {
    expect(res.body.status).to.equal("in_kitchen");
  });
}

docs {
  **`PATCH /orders/{order_id}/status`**

  Cambia el estado del pedido. Notifica por WebSocket (`order_status_changed`). `status`: `pending` | `in_kitchen` | `served` | `paid` | `cancelled`.

  **Roles permitidos:** admin, waiter, kitchen, bartender

  **Auth en este request:** Bearer `{{tokenKitchen}}` (kitchen)

  **Respuestas posibles:**

  - `200`: `OrderOut` (pedir el mismo estado devuelve 200 sin cambios)
  - `401`: sin token (`unauthorized`)
  - `403`: rol no permitido (`forbidden`)
  - `404`: `Order not found` (`not_found`)
  - `409`: `Cannot change status from '<actual>' to '<nuevo>'` (`conflict`)
  - `422`: `status` fuera de `pending|in_kitchen|served|paid|cancelled` (`validation_error`)
}
