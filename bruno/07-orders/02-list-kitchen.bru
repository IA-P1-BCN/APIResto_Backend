meta {
  name: Listar pedidos pendientes de la mesa (kitchen)
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/orders/?status=pending&table_id={{tableId}}&skip=0&limit=100
  body: none
  auth: bearer
}

params:query {
  status: pending
  table_id: {{tableId}}
  skip: 0
  limit: 100
}

auth:bearer {
  token: {{tokenKitchen}}
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });

  test("devuelve una lista", function() {
    expect(res.body).to.be.an("array");
  });

  test("incluye el pedido y todos están pending", function() {
    expect(res.body.map(o => o.id)).to.include(bru.getVar("orderId"));
    res.body.forEach(o => expect(o.status).to.equal("pending"));
  });
}

docs {
  **`GET /orders/`**

  Lista simple (no `Page`). Filtros: `status`, `table_id`, `date_from`, `date_to`; paginación `skip`/`limit`. No hay filtro por estación (HU-40 pendiente).

  **Roles permitidos:** admin, waiter, kitchen, bartender

  **Auth en este request:** Bearer `{{tokenKitchen}}` (kitchen)

  **Respuestas posibles:**

  - `200`: `list[OrderOut]`
  - `401`: sin token
  - `403`: rol no permitido
  - `404`: `Order not found` / `Table not found` / `Order item not found`
  - `409`: transición no válida, plato no disponible o pedido cerrado
  - `422`: datos no válidos
}
