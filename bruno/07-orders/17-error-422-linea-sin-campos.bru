meta {
  name: Error 422 · marcar línea sin prepared ni served
  type: http
  seq: 17
}

patch {
  url: {{baseUrl}}/orders/:order_id/items/:item_id
  body: json
  auth: bearer
}

params:path {
  order_id: {{orderId}}
  item_id: {{orderItemId}}
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {}
}

tests {
  test("status 422", function() {
    expect(res.status).to.equal(422);
  });

  test("error {detail, code} con code validation_error", function() {
    expect(res.body.detail).to.be.a("string");
    expect(res.body.code).to.equal("validation_error");
  });
  test("incluye la lista de errores de campo", function() {
    expect(res.body.errors).to.be.an("array").that.is.not.empty;
  });
}

docs {
  **`PATCH /orders/{order_id}/items/{item_id}`**

  Hay que enviar `prepared`, `served` o los dos.

  **Roles permitidos:** admin, waiter, kitchen, bartender

  **Auth en este request:** Bearer `{{token}}` (admin)

  **Respuestas posibles:**

  - `422`: `validation_error`
}
