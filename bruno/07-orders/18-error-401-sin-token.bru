meta {
  name: Error 401 · crear pedido sin token
  type: http
  seq: 18
}

post {
  url: {{baseUrl}}/orders/
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "table_id": {{tableId}},
    "items": []
  }
}

tests {
  test("status 401", function() {
    expect(res.status).to.equal(401);
  });

  test("error {detail, code} con code unauthorized", function() {
    expect(res.body.detail).to.be.a("string");
    expect(res.body.code).to.equal("unauthorized");
  });
}

docs {
  **`POST /orders/`**

  Requiere token.

  **Roles permitidos:** admin, waiter

  **Auth en este request:** ninguna

  **Respuestas posibles:**

  - `401`: `Not authenticated`
}
