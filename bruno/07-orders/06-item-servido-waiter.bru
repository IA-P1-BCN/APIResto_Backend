meta {
  name: Marcar línea servida (waiter)
  type: http
  seq: 6
}

patch {
  url: {{baseUrl}}/orders/:order_id/items/:item_id
  body: json
  auth: bearer
}

params:path {
  order_id: {{orderId}}
  item_id: {{orderItemId}}
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{tokenWaiter}}
}

body:json {
  {
    "served": true
  }
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });

  test("línea servida", function() {
    expect(res.body.items[0].served).to.equal(true);
  });
}

docs {
  **`PATCH /orders/{order_id}/items/{item_id}`**

  La sala marca la línea como servida en la mesa.

  **Roles permitidos:** admin, waiter (campo `served`)

  **Auth en este request:** Bearer `{{tokenWaiter}}` (waiter)

  **Respuestas posibles:**

  - `200`: `OrderOut`
  - `401`: sin token
  - `403`: rol no permitido
  - `404`: `Order not found` / `Table not found` / `Order item not found`
  - `409`: transición no válida, plato no disponible o pedido cerrado
  - `422`: datos no válidos
}
