meta {
  name: Error 409 · transición de estado no válida
  type: http
  seq: 12
}

patch {
  url: {{baseUrl}}/orders/:order_id/status
  body: json
  auth: bearer
}

params:path {
  order_id: {{orderId}}
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{tokenWaiter}}
}

body:json {
  {
    "status": "pending"
  }
}

tests {
  test("status 409", function() {
    expect(res.status).to.equal(409);
  });

  test("error {detail, code} con code conflict", function() {
    expect(res.body.detail).to.be.a("string");
    expect(res.body.code).to.equal("conflict");
  });
}

docs {
  **`PATCH /orders/{order_id}/status`**

  `served → pending` no está permitido.

  **Roles permitidos:** admin, waiter, kitchen, bartender

  **Auth en este request:** Bearer `{{tokenWaiter}}` (waiter)

  **Respuestas posibles:**

  - `409`: `Cannot change status from 'served' to 'pending'`
}
