meta {
  name: Crear pedido (waiter)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/orders/
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{tokenWaiter}}
}

body:json {
  {
    "table_id": {{tableId}},
    "items": [
      {
        "dish_id": {{dishId}},
        "quantity": 2,
        "notes": "Sin cebolla"
      }
    ]
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("orderId", res.body.id);
    bru.setVar("orderItemId", res.body.items[0].id);
    bru.setVar("orderTotal", res.body.total);
  }
}

tests {
  test("status 201", function() {
    expect(res.status).to.equal(201);
  });

  test("shape: id, table_id, waiter_id, status, total, created_at, updated_at, items", function() {
    expect(res.body).to.have.property("id");
    expect(res.body).to.have.property("table_id");
    expect(res.body).to.have.property("waiter_id");
    expect(res.body).to.have.property("status");
    expect(res.body).to.have.property("total");
    expect(res.body).to.have.property("created_at");
    expect(res.body).to.have.property("updated_at");
    expect(res.body).to.have.property("items");
  });

  test("pendiente, del waiter y con total 2 x 13.00", function() {
    expect(res.body.status).to.equal("pending");
    expect(res.body.waiter_id).to.equal(bru.getVar("waiterId"));
    expect(Number(res.body.total)).to.equal(26);
  });

  test("línea sin preparar ni servir", function() {
    expect(res.body.items).to.have.lengthOf(1);
    expect(res.body.items[0].prepared).to.equal(false);
    expect(res.body.items[0].served).to.equal(false);
  });
}

docs {
  **`POST /orders/`**

  Crea un pedido `pending` con el precio actual de cada plato. `waiter_id` es el usuario que lo crea. Notifica a cocina por WebSocket (`order_created`). Guarda `orderId`, `orderItemId` y `orderTotal`.

  **Roles permitidos:** admin, waiter

  **Auth en este request:** Bearer `{{tokenWaiter}}` (waiter)

  **Respuestas posibles:**

  - `201`: `OrderOut`
  - `401`: sin token
  - `403`: rol no permitido
  - `404`: `Order not found` / `Table not found` / `Order item not found`
  - `409`: transición no válida, plato no disponible o pedido cerrado
  - `422`: datos no válidos
}
