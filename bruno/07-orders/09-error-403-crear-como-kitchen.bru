meta {
  name: Error 403 · crear pedido como kitchen
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/orders/
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{tokenKitchen}}
}

body:json {
  {
    "table_id": {{tableId}},
    "items": [
      {
        "dish_id": {{dishId}},
        "quantity": 1
      }
    ]
  }
}

tests {
  test("status 403", function() {
    expect(res.status).to.equal(403);
  });

  test("error {detail, code} con code forbidden", function() {
    expect(res.body.detail).to.be.a("string");
    expect(res.body.code).to.equal("forbidden");
  });
}

docs {
  **`POST /orders/`**

  Solo admin y waiter crean pedidos.

  **Roles permitidos:** admin, waiter

  **Auth en este request:** Bearer `{{tokenKitchen}}` (kitchen)

  **Respuestas posibles:**

  - `403`: `Not enough permissions`
}
