meta {
  name: Error 404 · plato borrado
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/dishes/:dish_id
  body: none
  auth: bearer
}

params:path {
  dish_id: {{tempDishId}}
}

auth:bearer {
  token: {{token}}
}

tests {
  test("status 404", function() {
    expect(res.status).to.equal(404);
  });

  test("error {detail, code} con code not_found", function() {
    expect(res.body.detail).to.be.a("string");
    expect(res.body.code).to.equal("not_found");
  });
}

docs {
  **`GET /dishes/{dish_id}`**

  El plato temporal ya no existe.

  **Roles permitidos:** todos

  **Auth en este request:** Bearer `{{token}}` (admin)

  **Respuestas posibles:**

  - `404`: `Dish not found`
}
