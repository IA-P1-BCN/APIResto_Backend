meta {
  name: Error 401 · listar reservas sin token
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/reservations
  body: none
  auth: none
}

tests {
  test("status 401", function() {
    expect(res.status).to.equal(401);
  });

  test("error {detail, code} con code unauthorized", function() {
    expect(res.body.detail).to.be.a("string");
    expect(res.body.code).to.equal("unauthorized");
  });
}

docs {
  **`GET /reservations`**

  Requiere token.

  **Roles permitidos:** admin, waiter, customer

  **Auth en este request:** ninguna

  **Respuestas posibles:**

  - `401`: `unauthorized` (`Not authenticated`)
}
