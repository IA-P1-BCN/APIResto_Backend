meta {
  name: Error 403 · customer filtra por otro usuario
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/reservations?user_id={{waiterId}}
  body: none
  auth: bearer
}

params:query {
  user_id: {{waiterId}}
}

auth:bearer {
  token: {{tokenCustomer}}
}

tests {
  test("status 403", function() {
    expect(res.status).to.equal(403);
  });

  test("error {detail, code} con code reservation_forbidden", function() {
    expect(res.body.detail).to.be.a("string");
    expect(res.body.code).to.equal("reservation_forbidden");
  });
}

docs {
  **`GET /reservations`**

  Un customer no puede listar reservas de otro usuario.

  **Roles permitidos:** admin, waiter

  **Auth en este request:** Bearer `{{tokenCustomer}}` (customer)

  **Respuestas posibles:**

  - `403`: `Solo puedes ver tus propias reservas`
}
