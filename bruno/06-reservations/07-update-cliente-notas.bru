meta {
  name: Editar notas (customer dueño)
  type: http
  seq: 7
}

patch {
  url: {{baseUrl}}/reservations/:reservation_id
  body: json
  auth: bearer
}

params:path {
  reservation_id: {{customerReservationId}}
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{tokenCustomer}}
}

body:json {
  {
    "notes": "Mesa cerca de la ventana"
  }
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });

  test("shape: id, user_id, table_id, reserved_at, duration_min, ends_at, party_size, status, notes, created_at", function() {
    expect(res.body).to.have.property("id");
    expect(res.body).to.have.property("user_id");
    expect(res.body).to.have.property("table_id");
    expect(res.body).to.have.property("reserved_at");
    expect(res.body).to.have.property("duration_min");
    expect(res.body).to.have.property("ends_at");
    expect(res.body).to.have.property("party_size");
    expect(res.body).to.have.property("status");
    expect(res.body).to.have.property("notes");
    expect(res.body).to.have.property("created_at");
  });

  test("notas actualizadas", function() {
    expect(res.body.notes).to.equal("Mesa cerca de la ventana");
  });
}

docs {
  **`PATCH /reservations/{reservation_id}`**

  El dueño puede editar su reserva (salvo `status`).

  **Roles permitidos:** admin, waiter y el dueño

  **Auth en este request:** Bearer `{{tokenCustomer}}` (customer)

  **Respuestas posibles:**

  - `200`: `ReservationRead`
  - `401`: sin token o token no válido (`unauthorized`)
  - `403`: rol sin acceso o reserva de otro usuario (`forbidden`); customer que cambia `status` (`reservation_forbidden`)
  - `404`: reserva inexistente (`reservation_not_found`); mesa nueva inexistente (`table_not_found`)
  - `409`: solapamiento con otra reserva activa de la mesa (`reservation_conflict`)
  - `422`: datos no válidos, p. ej. campo extra o `null` en un campo distinto de `notes` (`validation_error`); `party_size` > capacidad de la mesa (`party_size_exceeds_capacity`)
}
