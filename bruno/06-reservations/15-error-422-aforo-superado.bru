meta {
  name: Error 422 · party_size mayor que la capacidad
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/reservations
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "table_id": {{tableId}},
    "reserved_at": "{{reservedAtCapacity}}",
    "party_size": 50
  }
}

tests {
  test("status 422", function() {
    expect(res.status).to.equal(422);
  });

  test("error {detail, code} con code party_size_exceeds_capacity", function() {
    expect(res.body.detail).to.be.a("string");
    expect(res.body.code).to.equal("party_size_exceeds_capacity");
  });
}

docs {
  **`POST /reservations`**

  `party_size` (50) mayor que la `capacity` de la mesa `{{tableId}}`. La capacidad se comprueba antes que el solapamiento.

  **Roles permitidos:** admin, waiter, customer

  **Auth en este request:** Bearer `{{token}}` (admin)

  **Respuestas posibles:**

  - `422`: `party_size_exceeds_capacity`
}
