meta {
  name: Error 404 · reserva inexistente
  type: http
  seq: 14
}

get {
  url: {{baseUrl}}/reservations/:reservation_id
  body: none
  auth: bearer
}

params:path {
  reservation_id: 999999999
}

auth:bearer {
  token: {{token}}
}

tests {
  test("status 404", function() {
    expect(res.status).to.equal(404);
  });

  test("error {detail, code} con code reservation_not_found", function() {
    expect(res.body.detail).to.be.a("string");
    expect(res.body.code).to.equal("reservation_not_found");
  });
}

docs {
  **`GET /reservations/{reservation_id}`**

  Id que no existe.

  **Roles permitidos:** admin, waiter y el dueño

  **Auth en este request:** Bearer `{{token}}` (admin)

  **Respuestas posibles:**

  - `404`: `reservation_not_found`
}
