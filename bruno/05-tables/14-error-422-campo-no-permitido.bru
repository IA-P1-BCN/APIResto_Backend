meta {
  name: Error 422 · campo extra no permitido
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/tables
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "number": {{tempTableNumber}},
    "capacity": 2,
    "location": "indoor",
    "color": "rojo"
  }
}

tests {
  test("status 422", function() {
    expect(res.status).to.equal(422);
  });

  test("error {detail, code} con code validation_error", function() {
    expect(res.body.detail).to.be.a("string");
    expect(res.body.code).to.equal("validation_error");
  });
  test("incluye la lista de errores de campo", function() {
    expect(res.body.errors).to.be.an("array").that.is.not.empty;
  });
}

docs {
  **`POST /tables`**

  Los schemas de mesa usan `extra="forbid"`: un campo desconocido devuelve 422.

  **Roles permitidos:** admin

  **Auth en este request:** Bearer `{{token}}` (admin)

  **Respuestas posibles:**

  - `422`: `validation_error`
}
