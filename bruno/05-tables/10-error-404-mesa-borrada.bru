meta {
  name: Error 404 · mesa borrada
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/tables/:table_id
  body: none
  auth: bearer
}

params:path {
  table_id: {{tempTableId}}
}

auth:bearer {
  token: {{token}}
}

tests {
  test("status 404", function() {
    expect(res.status).to.equal(404);
  });

  test("error {detail, code} con code not_found", function() {
    expect(res.body.detail).to.be.a("string");
    expect(res.body.code).to.equal("not_found");
  });
}

docs {
  **`GET /tables/{table_id}`**

  La mesa temporal ya no existe.

  **Roles permitidos:** admin, waiter

  **Auth en este request:** Bearer `{{token}}` (admin)

  **Respuestas posibles:**

  - `404`: `Table <id> not found`
}
