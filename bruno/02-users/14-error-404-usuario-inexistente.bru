meta {
  name: Error 404 · usuario inexistente
  type: http
  seq: 14
}

get {
  url: {{baseUrl}}/users/:user_id
  body: none
  auth: bearer
}

params:path {
  user_id: 999999999
}

auth:bearer {
  token: {{token}}
}

tests {
  test("status 404", function() {
    expect(res.status).to.equal(404);
  });

  test("error {detail, code} con code not_found", function() {
    expect(res.body.detail).to.be.a("string");
    expect(res.body.code).to.equal("not_found");
  });
}

docs {
  **`GET /users/{user_id}`**

  Id que no existe.

  **Roles permitidos:** admin

  **Auth en este request:** Bearer `{{token}}` (admin)

  **Respuestas posibles:**

  - `401`: sin token
  - `403`: el rol no es admin
  - `404`: `User not found`
}
