meta {
  name: Error 422 · nueva contraseña igual a la actual
  type: http
  seq: 22
}

post {
  url: {{baseUrl}}/users/me/password
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{tokenBartender}}
}

body:json {
  {
    "current_password": "{{newBartenderPassword}}",
    "new_password": "{{newBartenderPassword}}"
  }
}

tests {
  test("status 422", function() {
    expect(res.status).to.equal(422);
  });

  test("error {detail, code} con code same_password", function() {
    expect(res.body.detail).to.be.a("string");
    expect(res.body.code).to.equal("same_password");
  });
}

docs {
  **`POST /users/me/password`**

  No se acepta como nueva la misma contraseña (decisión de la spec de HU-25). La actual es `newBartenderPassword`, la de `18-change-password-bartender`.

  **Roles permitidos:** cualquier usuario autenticado

  **Auth en este request:** Bearer `{{tokenBartender}}` (bartender)

  **Respuestas posibles:**

  - `204`: contraseña cambiada, sin cuerpo
  - `400`: la cuenta no tiene contraseña, solo login social (`password_not_set`)
  - `401`: sin token o token inválido (`unauthorized`)
  - `403`: la contraseña actual no es correcta (`invalid_current_password`)
  - `422`: datos no válidos (`validation_error`) o nueva contraseña igual a la actual (`same_password`)
}
