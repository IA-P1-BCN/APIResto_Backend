meta {
  name: Error 401 · crear usuario sin token
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/users/
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Sin token",
    "email": "sintoken.{{runId}}@restoapi.example.com",
    "password": "{{testPassword}}"
  }
}

tests {
  test("status 401", function() {
    expect(res.status).to.equal(401);
  });

  test("error {detail, code} con code unauthorized", function() {
    expect(res.body.detail).to.be.a("string");
    expect(res.body.code).to.equal("unauthorized");
  });
}

docs {
  **`POST /users/`**

  Sin token no se puede crear usuarios.

  **Roles permitidos:** admin

  **Auth en este request:** ninguna

  **Respuestas posibles:**

  - `401`: `Not authenticated`
}
