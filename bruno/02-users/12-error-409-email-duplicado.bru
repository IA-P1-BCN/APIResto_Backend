meta {
  name: Error 409 · email ya registrado
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/users/
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "Duplicado Bruno",
    "email": "{{waiterEmail}}",
    "password": "{{testPassword}}"
  }
}

tests {
  test("status 409", function() {
    expect(res.status).to.equal(409);
  });

  test("error {detail, code} con code conflict", function() {
    expect(res.body.detail).to.be.a("string");
    expect(res.body.code).to.equal("conflict");
  });
}

docs {
  **`POST /users/`**

  Crear un usuario con un email existente devuelve 409.

  **Roles permitidos:** admin

  **Auth en este request:** Bearer `{{token}}` (admin)

  **Respuestas posibles:**

  - `201`: `UserOut` (sin contraseña)
  - `401`: sin token
  - `403`: el rol no es admin
  - `409`: `Email already registered`
  - `422`: datos no válidos (p. ej. email mal formado)
}
