meta {
  name: Login bartender con la contraseña nueva
  type: http
  seq: 19
}

post {
  url: {{baseUrl}}/auth/login
  body: formUrlEncoded
  auth: none
}

headers {
  Content-Type: application/x-www-form-urlencoded
}

body:form-urlencoded {
  username: {{bartenderEmail}}
  password: {{newBartenderPassword}}
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });

  test("shape: access_token, token_type", function() {
    expect(res.body).to.have.property("access_token");
    expect(res.body.token_type).to.equal("bearer");
  });
}

docs {
  **`POST /auth/login`**

  Comprueba que el cambio de `18-change-password-bartender` ha surtido efecto: la contraseña nueva entra.

  **Roles permitidos:** público

  **Auth en este request:** ninguna

  **Respuestas posibles:**

  - `200`: `{access_token, token_type: "bearer"}`
  - `401`: credenciales incorrectas o usuario desactivado (`unauthorized`)
  - `422`: faltan `username` o `password` (`validation_error`)
}
