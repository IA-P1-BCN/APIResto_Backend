meta {
  name: Error 403 · crear categoría como customer
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/categories/
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{tokenCustomer}}
}

body:json {
  {
    "name": "No permitido {{runId}}"
  }
}

tests {
  test("status 403", function() {
    expect(res.status).to.equal(403);
  });

  test("error {detail, code} con code forbidden", function() {
    expect(res.body.detail).to.be.a("string");
    expect(res.body.code).to.equal("forbidden");
  });
}

docs {
  **`POST /categories/`**

  Solo admin escribe en el menú.

  **Roles permitidos:** admin

  **Auth en este request:** Bearer `{{tokenCustomer}}` (customer)

  **Respuestas posibles:**

  - `403`: `Not enough permissions`
}
