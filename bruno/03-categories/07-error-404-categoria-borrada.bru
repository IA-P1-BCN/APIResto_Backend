meta {
  name: Error 404 · categoría borrada
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/categories/:category_id
  body: none
  auth: bearer
}

params:path {
  category_id: {{tempCategoryId}}
}

auth:bearer {
  token: {{token}}
}

tests {
  test("status 404", function() {
    expect(res.status).to.equal(404);
  });

  test("error {detail, code} con code not_found", function() {
    expect(res.body.detail).to.be.a("string");
    expect(res.body.code).to.equal("not_found");
  });
}

docs {
  **`GET /categories/{category_id}`**

  La categoría borrada ya no existe.

  **Roles permitidos:** todos

  **Auth en este request:** Bearer `{{token}}` (admin)

  **Respuestas posibles:**

  - `404`: `Category not found`
}
