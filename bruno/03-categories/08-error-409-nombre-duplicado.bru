meta {
  name: Error 409 · nombre de categoría duplicado
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/categories/
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "{{categoryName}}"
  }
}

tests {
  test("status 409", function() {
    expect(res.status).to.equal(409);
  });

  test("error {detail, code} con code conflict", function() {
    expect(res.body.detail).to.be.a("string");
    expect(res.body.code).to.equal("conflict");
  });
}

docs {
  **`POST /categories/`**

  El nombre de categoría es único.

  **Roles permitidos:** admin

  **Auth en este request:** Bearer `{{token}}` (admin)

  **Respuestas posibles:**

  - `409`: `Category already exists`
}
