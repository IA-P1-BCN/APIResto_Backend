meta {
  name: Error 422 · from posterior a to
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/stats/sales?from=2026-12-31&to=2026-01-01
  body: none
  auth: bearer
}

params:query {
  from: 2026-12-31
  to: 2026-01-01
}

auth:bearer {
  token: {{token}}
}

tests {
  test("status 422", function() {
    expect(res.status).to.equal(422);
  });

  test("error {detail, code} con code invalid_date_range", function() {
    expect(res.body.detail).to.be.a("string");
    expect(res.body.code).to.equal("invalid_date_range");
  });
}

docs {
  **`GET /stats/sales`**

  `from` debe ser anterior o igual a `to`.

  **Roles permitidos:** admin

  **Auth en este request:** Bearer `{{token}}` (admin)

  **Respuestas posibles:**

  - `422`: `invalid_date_range`
}
